<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black">

    <!-- The canvas takes whatever the extra keys leave; the status line floats over it rather
         than taking height, so a message never reflows the desktop. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <tech.ula.vnc.view.VncCanvas
            android:id="@+id/vnc_canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/vnc_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#E0263238"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <tech.ula.vnc.app.VncExtraKeysView
        android:id="@+id/vnc_extra_keys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
